{
    "name": "nakas-seo",
    "version": "0.1.2",
    "type": "module",
    "description": "Real-time SEO analysis tool providing instant, lightweight feedback to improve web content while coding",
    "keywords": [
        "developer-tool",
        "seo",
        "seo-tool",
        "seo-analysis",
        "content-optimization"
    ],
    "license": "MIT",
    "author": "Ikram Mbechezi",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "files": [
        "dist"
    ],
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./components/*": {
            "types": "./dist/components/*.d.ts",
            "import": "./dist/components/*.js",
            "default": "./dist/components/*.js"
        },
        "./lib/*": {
            "types": "./dist/lib/*.d.ts",
            "import": "./dist/lib/*.js",
            "default": "./dist/lib/*.js"
        },
        "./dist/*": {
            "types": "./dist/*.d.ts",
            "import": "./dist/*.js",
            "default": "./dist/*.js"
        }
    },
    "scripts": {
        "build:css": "rimraf dist/styles && esbuild src/styles/index.css --bundle --minify --outfile=dist/styles/index.css",
        "clean": "rimraf dist",
        "build": "pnpm run clean && tsc && pnpm run build:css",
        "lint": "eslint \"src/**/*.{ts,tsx}\"",
        "lint:fix": "eslint \"src/**/*.{ts,tsx}\" --fix"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "25.2.2",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.4",
        "esbuild": "^0.28.1",
        "eslint": "^10.8.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-prettier": "^5.5.6",
        "globals": "^17.8.0",
        "nakas-ui": "https://github.com/IkramMbz/nakas-ui.git",
        "next": "16.2.12",
        "prettier": "^3.9.6",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "rimraf": "^6.1.3",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.65.0"
    },
    "dependencies": {
        "lucide-react": "^0.563.0"
    },
    "peerDependencies": {
        "react": "^18 || ^19",
        "react-dom": "^18 || ^19"
    },
    "pnpm": {
        "overrides": {
            "minimatch": "10.2.6",
            "flatted": "3.4.2",
            "picomatch": "4.0.4",
            "postcss": "8.5.18",
            "sharp": "0.35.0",
            "js-yaml": "4.3.0",
            "ajv": "6.14.0"
        }
    }
}