{
    "name": "glitch-seo",
    "version": "0.3.0",
    "description": "Real-time SEO analysis tool providing instant, lightweight feedback to improve web content while coding",
    "keywords": [
        "content-optimization",
        "developer-tool",
        "seo",
        "seo-analysis",
        "seo-tool"
    ],
    "license": "MIT",
    "author": "Ikram Mbechezi",
    "files": [
        "dist"
    ],
    "type": "module",
    "sideEffects": [
        "*.css"
    ],
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./styles.css": "./dist/styles/index.css",
        "./components/*": {
            "types": "./dist/components/*.d.ts",
            "import": "./dist/components/*.js",
            "default": "./dist/components/*.js"
        },
        "./lib/*": {
            "types": "./dist/lib/*.d.ts",
            "import": "./dist/lib/*.js",
            "default": "./dist/lib/*.js"
        }
    },
    "scripts": {
        "build:css": "rimraf dist/styles && esbuild src/styles/index.css --bundle --minify --outfile=dist/styles/index.css",
        "clean": "rimraf dist",
        "build": "pnpm run clean && pnpm run fmt:check && pnpm run lint && tsc && pnpm run build:css",
        "dev": "tsc --watch",
        "lint": "oxlint --max-warnings=0",
        "lint:fix": "eslint \"src/**/*.{ts,tsx}\" --fix",
        "fmt": "oxfmt",
        "fmt:check": "oxfmt --check && prettier --check \"**/*.{css,md,json}\""
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^26.6.5",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "esbuild": "^0.28.2",
        "eslint": "^10.13.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-oxlint": "^1.88.0",
        "eslint-plugin-prettier": "^5.5.7",
        "globals": "^17.13.0",
        "oxfmt": "^0.73.0",
        "oxlint": "^1.88.0",
        "oxlint-tsgolint": "^7.0.2004",
        "prettier": "^3.9.10",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "rimraf": "^6.1.3",
        "typescript": "^7.0.2",
        "typescript-eslint": "^8.71.2"
    },
    "peerDependencies": {
        "react": "^18 || ^19",
        "react-dom": "^18 || ^19"
    }
}
